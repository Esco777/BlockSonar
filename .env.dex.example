# Server-side only. Set these in the process environment; do not prefix with VITE_.
# Copy values into your server environment or launch with Node --env-file.
# For local development, npm run db:start generates a private connection in .env.
# The example below is for a separately provisioned PostgreSQL instance.
DEX_DATABASE_URL=postgresql://blocksonar:change-me@127.0.0.1:5432/blocksonar
# Set your Alchemy API key here or in the project's ignored .env file.
# With this key, the server automatically uses Alchemy Base Mainnet.
# ALCHEMY_API_KEY=your-key-if-not-already-in-dotenv
# Optional: override Alchemy with a complete RPC URL (takes precedence).
DEX_BASE_RPC_URL=
# Comma-separated Base Uniswap V3 pool addresses. Verified against factory on-chain.
DEX_BASE_POOLS=
# Required explicit historical start block. Changing an existing job requires a reviewed reset.
DEX_BASE_START_BLOCK=
# Ethereum is opt-in and runs independently from Base. Enable ETH_MAINNET in Alchemy.
# Leave the Ethereum settings commented until ready; a shared key alone does not enable it.
# DEX_ETHEREUM_RPC_URL=https://your-other-ethereum-provider.example
# Comma-separated verified Uniswap V2 pairs and/or Uniswap V3 pools.
# DEX_ETHEREUM_POOLS=
# DEX_ETHEREUM_START_BLOCK=
# DEX_ETHEREUM_BATCH_BLOCKS=10
# DEX_ETHEREUM_POLL_MS=10000
# BNB Chain: opt-in PancakeSwap V2 pairs / V3 pools; same Alchemy API key.
# Enable BNB_MAINNET in the Alchemy app before configuring these.
# DEX_BSC_RPC_URL=https://your-other-bnb-provider.example
# DEX_BSC_POOLS=
# DEX_BSC_START_BLOCK=
# DEX_BSC_BATCH_BLOCKS=10
# DEX_BSC_POLL_MS=10000
# Solana uses finalized signatures/slots and a separate RPC architecture.
# Enable SOLANA_MAINNET in the same Alchemy app. Pool addresses are case-sensitive.
# DEX_SOLANA_RPC_URL=https://your-other-solana-provider.example
# DEX_SOLANA_POOLS=
# DEX_SOLANA_START_SLOT=
# DEX_SOLANA_PAGE_SIZE=10
# DEX_SOLANA_POLL_MS=10000
# Alchemy free-tier eth_getLogs supports 10-block ranges on Base.
DEX_BATCH_BLOCKS=10
DEX_POLL_MS=10000
# Shared operator access token, required in production until subscriber auth is integrated.
# Generate a strong random value. Never place this in a frontend environment variable.
DEX_READ_TOKEN=
