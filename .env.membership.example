# Copy these entries into your existing .env without overwriting other settings.
# Example business settings; choose your own before deployment.
MEMBERSHIP_OWNER=0xYourOwnerWalletAddress
# Public mint price is fixed in the contract at $200 USD, payable in ETH.
MEMBERSHIP_MAX_PRICE_AGE_SECONDS=7200
# Set the correct Chainlink ETH/USD proxy for your target chain.
# Sepolia example (verify against Chainlink docs before deploying):
# MEMBERSHIP_ETH_USD_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306
# Local chain 31337 automatically uses a clearly labeled test-only $4,000 mock.
MEMBERSHIP_MAX_SUPPLY=10000
MEMBERSHIP_BASE_URI=ipfs://YOUR_METADATA_CID/
MEMBERSHIP_RPC_URL=http://127.0.0.1:8545
# Testnet only. Never prefix a secret with VITE_.
# ETHEREUM_RPC_URL=https://your-deployment-ethereum-rpc
# SEPOLIA_RPC_URL=https://your-sepolia-rpc
# DEPLOYER_PRIVATE_KEY=0xYourTestnetPrivateKey

# Public frontend configuration (safe to expose; never put a private key here).
# Set after deploying the membership contract, then restart Vite.
VITE_MEMBERSHIP_CONTRACT_ADDRESS=
VITE_MEMBERSHIP_CHAIN_ID=11155111

# Backend membership enforcement (required; no anonymous API bypass).
# Must match the deployed contract and chain used by the frontend.
MEMBERSHIP_CONTRACT_ADDRESS=
MEMBERSHIP_CHAIN_ID=11155111
# Exact website origins allowed to sign in. HTTPS is required in production.
# MEMBERSHIP_APP_ORIGINS=https://your-blocksonar-domain.com
# Local development accepts localhost/127.0.0.1 ports 3000, 4001, 5173 and 5174.
# Sessions last 8 hours; membership is rechecked within 5 seconds on requests.
# Live streams recheck every 10 seconds and close on logout or membership loss.

# Optional BNB membership deployment. Keep blank until deployed.
MEMBERSHIP_BNB_CONTRACT_ADDRESS=
MEMBERSHIP_BNB_CHAIN_ID=56
# MEMBERSHIP_BNB_RPC_URL=https://your-private-bnb-rpc
# BNB_RPC_URL=https://your-deployment-bnb-rpc
# BNB_TESTNET_RPC_URL=https://your-deployment-bnb-testnet-rpc
# MEMBERSHIP_BNB_USD_FEED=matching-native-BNB-USD-Chainlink-proxy

# Optional Solana membership deployment. Keep blank until deployed and initialized.
MEMBERSHIP_SOLANA_PROGRAM_ID=
MEMBERSHIP_SOLANA_CLUSTER=mainnet-beta
# MEMBERSHIP_SOLANA_RPC_URL=https://your-private-solana-rpc
# MEMBERSHIP_SOLANA_GENESIS_HASH=required-for-localnet
# MEMBERSHIP_SOLANA_DEPLOYER_KEYPAIR=/secure/path/to/deployer.json
# MEMBERSHIP_SOLANA_PRICE_ACCOUNT=canonical-full-verification-Pyth-SOL-USD-account
MEMBERSHIP_SOLANA_MAX_PRICE_AGE_SECONDS=120
# Keep the configured Pyth account updated; stale prices disable purchases.
# Production requires revoking the program upgrade authority after initialization.
