{
  "name": "block-sonar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:server": "tsc -p server/tsconfig.json",
    "build:production": "node scripts/build-production.mjs",
    "start": "node scripts/start-production.mjs",
    "start:server": "npm run build:server && node server/dist/server/index.js",
    "test:server": "npm run build:server && node --test server/*.test.mjs",
    "contracts:compile": "hardhat compile",
    "contracts:test": "node scripts/test-contracts.cjs",
    "contracts:test:fork": "node scripts/test-contracts.cjs --fork-only",
    "contracts:node": "hardhat node --hostname 127.0.0.1",
    "contracts:deploy:local": "hardhat run scripts/deploy-local.cjs --network localhost",
    "contracts:deploy:sepolia": "hardhat run scripts/deploy-sepolia.cjs --network sepolia",
    "contracts:open:sepolia": "hardhat run scripts/open-sepolia-mint.cjs --network sepolia",
    "membership:check": "node scripts/check-membership.cjs",
    "db:start": "node scripts/local-dex-db.mjs",
    "contracts:deploy:bnb": "hardhat run scripts/deploy-membership.cjs --network bnb",
    "contracts:deploy:bnb-testnet": "hardhat run scripts/deploy-membership.cjs --network bnbTestnet",
    "solana:keygen": "node scripts/solana-membership.mjs keygen",
    "solana:build": "cargo build-sbf --manifest-path solana/programs/blocksonar-membership/Cargo.toml --arch v0",
    "solana:test": "cargo test --manifest-path solana/Cargo.toml",
    "solana:admin": "node scripts/solana-membership.mjs",
    "solana:test:integration": "npm run build:server && node scripts/solana-local-test.mjs",
    "contracts:deploy:ethereum": "hardhat run scripts/deploy-membership.cjs --network ethereum",
    "backup:create": "npm run build:server && node scripts/backup.mjs create",
    "backup:verify": "node scripts/backup.mjs verify",
    "contracts:walkthrough": "npm run build:server && hardhat test contracts/walkthrough/membership-flow.cjs",
    "contracts:check:sepolia": "hardhat run scripts/check-testnet.cjs --network sepolia",
    "contracts:check:bnb-testnet": "hardhat run scripts/check-testnet.cjs --network bnbTestnet",
    "tools:postgres": "sh scripts/install-postgres-client.sh",
    "market:check": "npm run build:server && node scripts/check-coingecko.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "buffer": "6.0.3",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "rpc-websockets": "9.2.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "chai": "^4.5.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "hardhat": "^2.26.3",
    "solc": "^0.8.26",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "8.3.2"
    }
  }
}
