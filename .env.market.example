# Optional CoinGecko authentication for Overview market snapshot requests.
# Sonar market lists always use the public API.
# Add ONE matching key to the existing server .env, then restart the backend.
# Without a key, the service uses CoinGecko's public API with bounded caching.
# Keys must never have a VITE_ prefix.
COINGECKO_DEMO_API_KEY=
COINGECKO_PRO_API_KEY=
# Alternative.me's daily Bitcoin Fear & Greed API requires no key.

# Alternative name (defaults to Demo unless COINGECKO_API_PLAN=pro):
# COINGECKO_API_KEY=
# COINGECKO_API_PLAN=demo
# CoinGecko settings may also be saved in .env.local. Restart the backend after editing.

